# Local working/scratch files (may contain read-only reference extracts — never commit)
.scratch/
.cache/

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
apps/api/data/

# Node
node_modules/
frontend/dist/
apps/admin-web/dist/

# Editors / OS
.vscode/
.idea/
.claude/settings.local.json
Thumbs.db
.DS_Store

# Python packaging metadata (regenerated by editable installs)
*.egg-info/

# Raw benchmark records (python -m qms_os.benchmark): only aggregates enter the repository (R-23)
/bench-results/

# Organisation-private local material (policy file, citation register) - never commit
.private/
.tmp/
.env
backups/
.venv/
.cache/

# Key material (authentication key files, certificates) - never commit; keep outside the repository
*.key
*.pem
